# eLMS -> Discord bridge configuration.
# Copy to .env (the setup wizard writes this file for you) and fill in.

# Any Neo LMS / CYPHER Learning site, e.g. https://elms.sti.edu
ELMS_BASE_URL=https://elms.sti.edu

# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Optional: post inside a thread instead of the channel the webhook belongs to.
DISCORD_THREAD_ID=

# How often the scheduler polls. Match it in the cron/task entry.
POLL_MINUTES=10

# Safety valves
MAX_POSTS_PER_CYCLE=8
DISCORD_BATCH_SIZE=5
SEEN_HISTORY=800

# Set to false to watch the browser while it polls (debugging).
HEADLESS=true

# Deadline reminders ---------------------------------------------------------
# Your Discord user ID (right-click profile > Copy User ID). Required for pings.
DISCORD_USER_ID=

# First ping when a submission is this many hours from its deadline...
REMINDER_LEAD_HOURS=6
# ...then repeat this often while it is still not submitted.
REMINDER_REPEAT_MINUTES=40
# Stop nagging this many hours after the deadline has passed.
REMINDER_AFTER_DUE_HOURS=3
